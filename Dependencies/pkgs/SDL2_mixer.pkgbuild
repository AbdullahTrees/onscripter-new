pkgname=SDL2_mixer
pkgver=2.8.2
pkgrel=1
depends=('SDL2' 'libogg' 'libvorbis')
sources=(
    "https://www.libsdl.org/projects/SDL_mixer/release/$pkgname-$pkgver.tar.gz"
    'SDL2_mixer-no-programs.patch'
    'SDL2_mixer-no-locks.patch'
)
hashes=(
    '938dff531d00ace2296557a6599abe6f34599e2f34f0a4a08a397e2ccac8b8f7'
    '80ccad9083f13d442f3c64b173e65b6166bcf2ed88dbd5964e7194cd94aa9205'
    '28be2fc1c07cbb2db602e3d29bc5784705a91729ac03e67fcb0e83cdade7eba2'
)

cflags="-O3"
cflags_win32="-I$outdir/include -I$outdir/include/vorbis -I$outdir/include/ogg -I$outdir/include/SDL2"
cppflags_win32="-I$outdir/include -I$outdir/include/vorbis -I$outdir/include/ogg -I$outdir/include/SDL2"

#FIXME: Is this still needed?
if [ "$(getTarget)" != "droid" ] && [ "$(getTarget)" != "darwin-macOS" ] && [ "$(getTarget)" != "darwin-iOS" ]; then
    ldflags=(
        '-lstdc++'
    )
fi

configopts=(
    '--disable-dependency-tracking'
    '--disable-shared'
    '--enable-static'
    '--enable-music-wave'
    '--disable-music-cmd'
    '--disable-music-mod'
    '--disable-music-mod-modplug'
    '--disable-music-mod-modplug-shared'
    '--disable-music-mod-xmp'
    '--disable-music-mod-xmp-shared'
    '--disable-music-midi'
    '--disable-music-midi-timidity'
    '--disable-music-midi-native'
    '--disable-music-midi-fluidsynth'
    '--disable-music-gme'
    '--disable-music-gme-shared'
    '--disable-music-flac'
    '--disable-music-flac-libflac'
    '--disable-music-flac-libflac-shared'
    '--enable-music-ogg'
    '--disable-music-ogg-stb'
    '--enable-music-ogg-vorbis'
    '--disable-music-ogg-vorbis-shared'
    '--enable-music-mp3'
    '--enable-music-mp3-minimp3'
    '--disable-music-mp3-mpg123'
    '--disable-music-mp3-mpg123-shared'
    '--disable-music-opus'
    '--disable-music-opus-shared'
    '--disable-music-wavpack'
    '--disable-music-wavpack-shared'
    '--disable-sdltest'
    "--libdir=$outdir/lib"
    "--with-sdl-prefix=$outdir"
)

prebuild() {
    pushd "$pkgname-$pkgver" &>/dev/null

    apply_patch "${sources[1]}"

    # This was introduced in https://hg.libsdl.org/SDL_mixer/diff/92882ef2ab81/mixer.c
    # It causes severe stuttering all over the game, for example right before d41020.
    # Reproducible on macOS, Windows, iOS and possibly all the other platforms.
    apply_patch "${sources[2]}"

    export PKG_CONFIG_PATH="$outdir/lib/pkgconfig:$outdir/share/pkgconfig:$PKG_CONFIG_PATH"
    export VORBIS_CFLAGS="-I$outdir/include"
    export VORBIS_LIBS="-L$outdir/lib -lvorbisfile -lvorbis -logg"
}

# Special version of this to ignore errors in extraction
# (required for this to work on mingw?)
extract_sources() {
    msg "Extracting sources"
    pushd $srcdir &>/dev/null

    local netfile
    for netfile in "${sources[@]}"; do
        local file=$(get_filename "$netfile")
        if in_array "$file" "${noextract[@]}"; then
            continue
        fi

        local filetype=$(file -bzL --mime "$file")
        local ext=${file##*.}
        local cmd=''

        case "$filetype" in
            *application/x-tar*)
                cmd='tar -xf';;
            *application/x-zip*|*application/zip*)
                cmd='unzip -q';;
            *)
                # MinGW32 has broken mime types in 'file' command, fall back on the
                # extension to work around
                case "$ext" in
                    bz2|gz|tar|xz)
                        # should look one more level in, to see if tar is there...
                        cmd='tar -xf';;
                    zip)
                        # should look one more level in, to see if tar is there...
                        cmd='unzip -q';;
                    *)
                        continue;;
                esac;;
        esac

        local ret=0
        msg2 "Extracting %s with %s" "$file" "$cmd"
        $cmd "$file" || ret=$?

        if (( ret )); then
            warn "Errors while extracting %s; plowing ahead" "$file"
        fi
    done

    popd &>/dev/null
}

# vim: set syntax=sh:
