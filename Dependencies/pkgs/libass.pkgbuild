pkgname=libass
pkgver=0.17.4
pkgrel=1
depends=('harfbuzz' 'fribidi')

sources=("https://github.com/libass/libass/releases/download/${pkgver}/libass-${pkgver}.tar.xz")
hashes=('78f1179b838d025e9c26e8fef33f8092f65611444ffa1bfc0cfac6a33511a05a')

configopts=(
    '--disable-shared'
    '--disable-fontconfig'
    '--disable-dependency-tracking'
    '--disable-require-system-font-provider'
    'ac_cv_header_iconv_h=no'
    "--libdir=$outdir/lib"
    "FREETYPE_CFLAGS=-I$outdir/include/freetype2"
    'FREETYPE_LIBS=-lfreetype'
    "FRIBIDI_CFLAGS=-I$outdir/include"
    'FRIBIDI_LIBS=-lfribidi'
    "ENCA_CFLAGS=-I$outdir/include"
    "ENCA_LIBS=-L$outdir/lib"
    "HARFBUZZ_CFLAGS=-I$outdir/include/harfbuzz"
    'HARFBUZZ_LIBS=-lharfbuzz'
)

configopts_win32=(
    '--build=x86_64-w64-mingw32'
    '--host=x86_64-w64-mingw32'
    '--disable-directwrite'
)

configopts_ios=( )
configopts_mac=( )

apple_darwin_host="x86_64-apple-darwin"
if [ "$(getTargetCPU)" == "arm64" ]; then
    apple_darwin_host="arm64-apple-darwin"
fi

configopts_mac_extra=(
    "--build=$apple_darwin_host"
    "--host=$apple_darwin_host"
    "CC=$(getCC)"
    "CXX=$(getCXX)"
)

cflags="-I$outdir/include/fribidi"
ldflags="-L$outdir/lib -lfreetype -lharfbuzz -lfribidi -lpng16 -lz"

postbuild() {
    # Is this necessary?
    case $(getTarget) in
    darwin*)
        unset CC
        unset CXX
    ;;
    esac
    
    popd &>/dev/null
}

#
download_file() {
    local url=$1
    local file=$2

    local ret=0
    if [ $USE_CURL ]; then
        curl -kL "$url" -o "$dldir/$file" || ret=$?
    else
        wget --no-check-certificate "$url" -O "$dldir/$file" || ret=$?
    fi
    
    if (( $ret )); then
        rm -f "$dldir/$file"
        error_out "Failed to download %s" "$file"
    fi
}

# vim: set syntax=sh:
