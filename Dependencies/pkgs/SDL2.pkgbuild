pkgname=SDL2
pkgver=2.32.10
pkgrel=1
sources=(
    "https://www.libsdl.org/release/SDL2-$pkgver.tar.gz"
    'SDL2-droid-noglctx-handle.patch'
    'SDL2-eventloop-mac.patch'
)
hashes=(
    '5f5993c530f084535c65a6879e9b26ad441169b3e25d789d83287040a9ca5165'
    '7550e7ddc1d6a12004ac24488abd6c512b3a40f0eb138aea9bf3d4f87f59e3f5'
    '67b7c5931039a43daab2609cd05fd25248b43f3b7f4188e9ed8a6e1cccce1d90'
)

cflags="-O3"
cflags_win32="-I$outdir/include/khronos"

configopts_win32=(
    '--enable-video-opengles1'
    '--enable-video-opengles2'
)

configopts_mac_extra=(
    '--disable-video-x11'
    '--disable-render-metal'
)

if option_set 'dynamic_sdl'; then
    sharedstatic="static"
else
    sharedstatic="shared"
fi

configopts=(
    '--disable-dependency-tracking'
    "--disable-$sharedstatic"
    '--disable-nas'
    '--disable-hidapi-libusb'
    '--disable-video-vulkan'
    '--enable-sse2'
    '--enable-haptic'
    '--enable-joystick'
    "--libdir=$outdir/lib"
)

cflags_ios_extra=(
    '-fobjc-arc'
)

configopts_droid=(
    '--disable-pulseaudio'
)

prebuild() {
    pushd "$pkgname-$pkgver" &>/dev/null

    case $(getTarget) in
        droid)
            # ONScripter's render thread owns the GL context on Android.
            apply_patch "${sources[1]}"
            export CC="$(getCC)"
            export CXX="$(getCXX)"
        ;;
        darwin-iOS)
            apply_patch "${sources[2]}"
        ;;
        darwin-macOS)
            apply_patch "${sources[2]}"
        ;;
    esac
}

compile() {
    case $(getTarget) in
        darwin-iOS)
            cp include/SDL_config_iphoneos.h include/SDL_config.h
        ;;
    esac

    local logfile="$logdir/$pkgname.compile.log"
    local ret=0
    make $MAKEOPTS &>"$logfile" || ret=$?
    if (( $ret )); then
        tail -n 20 "$logfile"
        error "Compiling %s failed" "$pkgname"
        error "The last 20 lines of the log are shown above."
        error "The full log is: %s" "$logfile"
        exit 1
    fi
}

postbuild() {

    # Windows is known for its sane MSYS
    if [ "$(getTarget)" == "win32" ]; then
        local cfgfile=$(cat "$outdir/bin/sdl2-config")
        cfgfile=${cfgfile//" -XCClinker"/""}
        echo "$cfgfile" >"$outdir/bin/sdl2-config"
    elif [ "$(getTarget)" == "droid" ]; then
        unset CC
        unset CXX
    fi

    popd &>/dev/null
}

# Official SDL2 archives contain symlinks that are not always creatable in
# Windows/MSYS2 worktrees. They are not required by this dependency build.
extract_sources() {
    msg "Extracting sources"
    pushd $srcdir &>/dev/null

    local netfile
    for netfile in "${sources[@]}"; do
        local file=$(get_filename "$netfile")
        if in_array "$file" "${noextract[@]}"; then
            continue
        fi

        local filetype=$(file -bzL --mime "$file")
        local ext=${file##*.}
        local cmd=''

        case "$filetype" in
            *application/x-tar*)
                cmd='tar -xf';;
            *application/x-zip*|*application/zip*)
                cmd='unzip -q';;
            *)
                case "$ext" in
                    bz2|gz|tar|xz)
                        cmd='tar -xf';;
                    zip)
                        cmd='unzip -q';;
                    *)
                        continue;;
                esac;;
        esac

        local ret=0
        msg2 "Extracting %s with %s" "$file" "$cmd"
        $cmd "$file" || ret=$?

        if (( ret )); then
            warn "Errors while extracting %s; plowing ahead" "$file"
        fi
    done

    popd &>/dev/null
}

# vim: set syntax=sh:
