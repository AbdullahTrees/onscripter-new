pkgname=libpng
pkgver=1.6.58
pkgrel=1
depends=('zlib')
sources=("https://downloads.sourceforge.net/libpng/libpng-${pkgver}.tar.xz")
hashes=('28eb403f51f0f7405249132cecfe82ea5c0ef97f1b32c5a65828814ae0d34775')

configopts=(
    '--disable-dependency-tracking'
    '--disable-shared'
    '--enable-hardware-optimizations=yes'
    "--libdir=$outdir/lib"
    "--with-zlib-prefix=$outdir"
)

cppflags_mac_extra=(
    "-I$outdir/include"
)

# vim: set syntax=sh:
