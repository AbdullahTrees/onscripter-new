pkgname=libpng
pkgver=1.6.58
pkgrel=1
depends=('zlib')
sources=("https://downloads.sourceforge.net/libpng/libpng-${pkgver}.tar.xz")
hashes=('5abe764ce7a55544f3259be87f4ed27b206b9ab1d6a285068f505e61a9583567')

configopts=(
    '--disable-dependency-tracking'
    '--disable-shared'
    '--enable-hardware-optimizations=yes'
    "--libdir=$outdir/lib"
    "--with-zlib-prefix=$outdir"
)

cppflags_mac_extra=(
    "-I$outdir/include"
)

# vim: set syntax=sh:
