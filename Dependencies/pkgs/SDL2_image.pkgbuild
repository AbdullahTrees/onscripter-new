pkgname=SDL2_image
pkgver=2.8.12
pkgrel=1
depends=('SDL2' 'jpeg' 'libpng')
sources=(
    "https://www.libsdl.org/projects/SDL_image/release/$pkgname-$pkgver.tar.gz"
    'SDL2_image-no-programs.patch'
)
hashes=(
    '393f5efb50536ec13ca4f4affb69cc9966d3c3f969e6c5e701faddf9f9785381'
    '8b057313640cc3d88e9585f31a96a4d81dc38d2775c4cc837344e76337215829'
)

cflags="-O3"
cflags_win32="-I$outdir/include -I$outdir/include/SDL2"
cppflags_win32="-I$outdir/include -I$outdir/include/SDL2"

configopts=(
    '--disable-dependency-tracking'
    '--disable-shared'
    '--enable-static'
    '--disable-stb-image'
    '--disable-avif'
    '--disable-avif-shared'
    '--disable-jxl'
    '--disable-jxl-shared'
    '--disable-tif'
    '--disable-tif-shared'
    '--disable-webp'
    '--disable-webp-shared'
    '--disable-jpg-shared'
    '--disable-save-jpg'
    '--disable-png-shared'
    '--disable-save-png'
    '--disable-sdltest'
    "--libdir=$outdir/lib"
    "--with-sdl-prefix=$outdir"
)

configopts_mac_extra=(
    '--disable-imageio'
)

configopts_ios_extra=(
    '--disable-imageio'
)

prebuild() {
    pushd "$pkgname-$pkgver" &>/dev/null

    apply_patch "${sources[1]}"

    export PKG_CONFIG_PATH="$outdir/lib/pkgconfig:$outdir/share/pkgconfig:$PKG_CONFIG_PATH"
    export LIBJPEG_CFLAGS="-I$outdir/include"
    export LIBJPEG_LIBS="-L$outdir/lib -ljpeg"
    export LIBPNG_CFLAGS="-I$outdir/include/libpng16"
    export LIBPNG_LIBS="-L$outdir/lib -lpng16"
}

# Special version of this to ignore errors in extraction
# (required for this to work on mingw?)
extract_sources() {
    msg "Extracting sources"
    pushd $srcdir &>/dev/null

    local netfile
    for netfile in "${sources[@]}"; do
        local file=$(get_filename "$netfile")
        if in_array "$file" "${noextract[@]}"; then
            continue
        fi

        local filetype=$(file -bzL --mime "$file")
        local ext=${file##*.}
        local cmd=''

        case "$filetype" in
            *application/x-tar*)
                cmd='tar -xf';;
            *application/x-zip*|*application/zip*)
                cmd='unzip -q';;
            *)
                # MinGW32 has broken mime types in 'file' command, fall back on the
                # extension to work around
                case "$ext" in
                    bz2|gz|tar|xz)
                        # should look one more level in, to see if tar is there...
                        cmd='tar -xf';;
                    zip)
                        # should look one more level in, to see if tar is there...
                        cmd='unzip -q';;
                    *)
                        continue;;
                esac;;
        esac

        local ret=0
        msg2 "Extracting %s with %s" "$file" "$cmd"
        $cmd "$file" || ret=$?

        if (( ret )); then
            warn "Errors while extracting %s; plowing ahead" "$file"
        fi
    done

    popd &>/dev/null
}

# vim: set syntax=sh:
