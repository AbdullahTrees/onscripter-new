pkgname=onscrlib
pkgver=1.0
pkgrel=1
type=meta

depends=(
    'bzip2'
    'zlib'
    'libpng'
    'libogg'
    'libvorbis'
    'jpeg'
    'ffmpeg'
    'harfbuzz'
    'freetype'
    'fribidi'
    'libass'
)

if option_set 'sdl3_renderer'; then
    depends=(${depends[@]} 'SDL3' 'SDL3_image' 'SDL3_mixer');
else
    depends=(${depends[@]} 'SDL2' 'SDL2_image' 'SDL2_mixer' 'SDL2_gpu');
fi

if [ "$(getTarget)" != "darwin-iOS" ] && [ "$(getTarget)" != "droid" ]; then
    depends=(${depends[@]} 'lua' 'libusb');
    if ! option_set 'sdl3_renderer'; then
        depends=(${depends[@]} 'libepoxy');
    fi
fi

if [ "$(getTarget)" == "droid" ] && [ "$(getTargetCPU)" != "arm" ]; then
    depends=(${depends[@]} 'libunwind');
fi


build() {
    msg "onscrlib built successfully."
}

# vim: set syntax=sh:
