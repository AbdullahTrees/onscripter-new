pkgname=onscrlib
pkgver=1.0
pkgrel=1
type=meta

depends=(
    'bzip2'
    'zlib'
    'libpng'
    'libogg'
    'libvorbis'
    'jpeg'
    'ffmpeg'
    'harfbuzz'
    'freetype'
    'fribidi'
    'libass'
    'SDL3'
    'SDL3_image'
    'SDL3_mixer'
)

if [ "$(getTarget)" != "darwin-iOS" ] && [ "$(getTarget)" != "droid" ]; then
    depends=(${depends[@]} 'lua' 'libusb');
fi

build() {
    msg "onscrlib built successfully."
}

# vim: set syntax=sh:
