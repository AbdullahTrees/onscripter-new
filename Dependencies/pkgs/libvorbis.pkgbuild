pkgname=libvorbis
pkgver=1.3.7
pkgrel=1
depends=('libogg')
sources=(
    "https://downloads.xiph.org/releases/vorbis/libvorbis-$pkgver.tar.xz"
    'libvorbis-droid-flags.patch'
)
hashes=(
    'b33cc4934322bcbf6efcbacf49e3ca01aadbea4114ec9589d1b1e9d20f72954b'
    '80cf75b3fcd075102c9804b02da150a579e974a33dbd5ffb90a7d0a650724542'
)

cflags_win32="-mstackrealign"

configopts=(
    '--disable-dependency-tracking'
    '--disable-shared'
    "--libdir=$outdir/lib"
)

prebuild() {
    pushd "$pkgname-$pkgver" &>/dev/null
    
    if [ "$(getTarget)" == "droid" ]; then
        # Seems to be only necessary for x86-like builds
        apply_patch "${sources[1]}"
    fi
}

# vim: set syntax=sh:
