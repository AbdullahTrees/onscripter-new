pkgname=harfbuzz
pkgver=14.2.0
pkgrel=1
depends=('freetype')
sources=("https://github.com/harfbuzz/harfbuzz/releases/download/${pkgver}/harfbuzz-${pkgver}.tar.xz")
hashes=('94017020f96d025bb66ae91574e4cf334bcad23e8175a8a40565b3721bc2eaff')

mesonopts=(
    '--buildtype=release'
    '--default-library=static'
    '-Dglib=disabled'
    '-Dgobject=disabled'
    '-Dcairo=disabled'
    '-Dchafa=disabled'
    '-Dpng=disabled'
    '-Dzlib=disabled'
    '-Dicu=disabled'
    '-Dgraphite2=disabled'
    '-Dfreetype=enabled'
    '-Dgdi=disabled'
    '-Ddirectwrite=disabled'
    '-Dcoretext=disabled'
    '-Dfontations=disabled'
    '-Dharfrust=disabled'
    '-Dkbts=disabled'
    '-Dwasm=disabled'
    '-Draster=disabled'
    '-Dvector=disabled'
    '-Dgpu=disabled'
    '-Dgpu_demo=disabled'
    '-Dsubset=disabled'
    '-Dtests=disabled'
    '-Dintrospection=disabled'
    '-Ddocs=disabled'
    '-Dutilities=disabled'
    '-Dbenchmark=disabled'
)

ldflags="-L$outdir/lib -lfreetype -lpng16 -lz"
ldflags_mac_extra="-stdlib=libc++"

prebuild() {
    pushd "$pkgname-$pkgver" &>/dev/null
}

configure() {
    msg "Running meson"

    local ret=0
    local logfile="$logdir/$pkgname.meson.log"
    local lcf="$CFLAGS ${cflags[@]} $CFLAGS_EXTRA"
    local lcxf="$CPPFLAGS ${cppflags[@]} ${cflags[@]} $CPPFLAGS_EXTRA $CFLAGS_EXTRA"
    local llf="$LDFLAGS ${ldflags[@]} $LDFLAGS_EXTRA"
    local meson_outdir="$outdir"
    local meson_prefix="$outdir"
    local meson_destdir="$outdir"
    local meson_pcdir="$PWD/.meson-pkgconfig"
    local meson_cross_args=()

    rm -rf build
    rm -rf "$meson_pcdir"
    mkdir -p "$meson_pcdir"

    if [ "$(getHost)" == "win32" ]; then
        meson_outdir="$(cygpath -m "$outdir")"
        if [ "$(getTarget)" == "droid" ]; then
            meson_prefix="/"
            meson_destdir="$meson_outdir"
        else
            meson_prefix="$meson_outdir"
        fi
        lcf="${lcf//$outdir/$meson_outdir}"
        lcxf="${lcxf//$outdir/$meson_outdir}"
        llf="${llf//$outdir/$meson_outdir}"
    fi
    if [ "$(getTarget)" == "droid" ] && command -v cygpath >/dev/null 2>&1; then
        meson_prefix="/"
    fi

    for pcdir in "$outdir/lib/pkgconfig" "$outdir/share/pkgconfig"; do
        if [ -d "$pcdir" ]; then
            for pcfile in "$pcdir"/*.pc; do
                [ -f "$pcfile" ] || continue
                sed "s#$outdir#$meson_outdir#g" "$pcfile" > "$meson_pcdir/$(basename "$pcfile")"
            done
        fi
    done

    local meson_cc="$(getCC)"
    local meson_cxx="$(getCXX)"
    if [ "$(getTarget)" == "droid" ]; then
        [ "$CMAKE_CC" != "" ] && meson_cc="$CMAKE_CC"
        [ "$CMAKE_CXX" != "" ] && meson_cxx="$CMAKE_CXX"

        local cpu_family="aarch64"
        local cpu="aarch64"
        if [ "$ANDROID_ABI" == "x86_64" ]; then
            cpu_family="x86_64"
            cpu="x86_64"
        fi

        local meson_cross="$PWD/ons-android-cross.ini"
        cat > "$meson_cross" <<EOF
[binaries]
c = '$meson_cc'
cpp = '$meson_cxx'
ar = '${CMAKE_AR:-$AR}'
strip = '${CMAKE_STRIP:-$STRIP}'
pkg-config = 'pkg-config'

[host_machine]
system = 'android'
cpu_family = '$cpu_family'
cpu = '$cpu'
endian = 'little'

[properties]
needs_exe_wrapper = true
EOF
        meson_cross_args=(--cross-file "$meson_cross")
    fi

    export CC="$meson_cc"
    export CXX="$meson_cxx"
    export CFLAGS="$lcf"
    export CXXFLAGS="$lcxf"
    export LDFLAGS="$llf"
    export PKG_CONFIG_PATH="$meson_pcdir:$PKG_CONFIG_PATH"
    export PKG_CONFIG_LIBDIR="$meson_pcdir"

    local old_arg_conv_excl="$MSYS2_ARG_CONV_EXCL"
    if [ "$(getTarget)" == "droid" ] && [ "$(getHost)" == "win32" ]; then
        export MSYS2_ARG_CONV_EXCL="--prefix="
    fi

    meson setup build \
        --prefix="$meson_prefix" \
        --libdir=lib \
        "${meson_cross_args[@]}" \
        "${mesonopts[@]}" &>"$logfile" || ret=$?

    export MSYS2_ARG_CONV_EXCL="$old_arg_conv_excl"
    unset CC
    unset CXX
    unset CFLAGS
    unset CXXFLAGS
    unset LDFLAGS
    unset PKG_CONFIG_PATH
    unset PKG_CONFIG_LIBDIR

    if (( $ret )); then
        tail -n 20 "$logfile"
        error "Meson setup %s failed" "$pkgname"
        error "The full log is: %s" "$logfile"
        exit 1
    fi
}

compile() {
    local logfile="$logdir/$pkgname.ninja.log"
    local ret=0
    ninja -C build &>"$logfile" || ret=$?
    if (( $ret )); then
        tail -n 20 "$logfile"
        error "Compiling %s failed" "$pkgname"
        error "The full log is: %s" "$logfile"
        exit 1
    fi
}

copy() {
    local logfile="$logdir/$pkgname.install.log"
    local ret=0
    if [ "$(getTarget)" == "droid" ]; then
        local meson_destdir="$outdir"
        if [ "$(getHost)" == "win32" ] && command -v cygpath >/dev/null 2>&1; then
            meson_destdir="$(cygpath -m "$outdir")"
        fi
        DESTDIR="$meson_destdir" ninja -C build install &>"$logfile" || ret=$?
        for pcdir in "$outdir/lib/pkgconfig" "$outdir/share/pkgconfig"; do
            [ -d "$pcdir" ] || continue
            for pcfile in "$pcdir"/*.pc; do
                [ -f "$pcfile" ] || continue
                sed -i "s#^prefix=.*#prefix=$outdir#" "$pcfile"
            done
        done
    else
        ninja -C build install &>"$logfile" || ret=$?
    fi
    if (( $ret )); then
        tail -n 20 "$logfile"
        error "Installing %s failed" "$pkgname"
        error "The full log is: %s" "$logfile"
        exit 1
    fi
}

postbuild() {
    # Freetype needs to be rebuilt with Harfbuzz support now
    rm -f "$outdir/.pkgs/freetype"
    rm -rf $(dirname "$outdir")/src/freetype*

    popd &>/dev/null
}

# vim: set syntax=sh:
